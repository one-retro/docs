; ============================================================================
; x.1sav.rtc.srtc - the Sharp S-RTC in a Super Famicom cartridge
;
; An extension key for the Universal Saves Format, defined by these
; specifications under a name reserved in the Vendor Names registry because
; the chip's registers belong to no one emulator.
;
; The root here is the value carried under the key, not a bundle. A bundle
; validates against the format's own schema whatever this holds, since an
; extension value is `any` there; this file is what makes the shape checkable.
; ============================================================================

rtc-srtc = {
  0 => [13*13 nybble], ; registers - index 0 to 12, as a read returns them
  ? 1 => #6.1(int),    ; taken_at  - the producer's clock when it took them
}

; Each register is four bits wide, and the chip's own digits stay one per
; element rather than being packed into bytes.
nybble = 0..15
