; ============================================================================
; x.1sav.rtc - a game's clock reading on the Unix scale
;
; An extension key for the Universal Saves Format, defined by these
; specifications under a name reserved in the Vendor Names registry.
;
; The root here is the value carried under the key, not a bundle. A bundle
; validates against the format's own schema whatever this holds, since an
; extension value is `any` there; this file is what makes the shape checkable.
; ============================================================================

rtc = {
  0 => reading-seconds, ; reading     - the game's clock, on the Unix scale
  ? 1 => uint,          ; accuracy_ms - uncertainty, in milliseconds
}

; Key 0 is the clock's own value, never the anchor a chip key carries. A
; counting clock reads as its elapsed time after 1970-01-01T00:00:00Z, and a
; dating clock as its components read as though they were UTC.
;
; Whole seconds only: tag 1 over an integer, never a float.
reading-seconds = #6.1(int)
