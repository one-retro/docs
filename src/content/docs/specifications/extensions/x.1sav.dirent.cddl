; ============================================================================
; x.1sav.dirent - what a card's directory records about one save
;
; An extension key for the Universal Saves Format, defined by these
; specifications under a name reserved in the Vendor Names registry because the
; value belongs to no single producer.
;
; The root here is the value carried under the key, not a bundle. A bundle
; validates against the format's own schema whatever this holds, since an
; extension value is `any` there; this file is what makes the shape checkable.
; ============================================================================

; At least one of the two times is present. A producer holding neither omits
; the key, so an empty map is not a value.
dirent = {
    0 => entry-time,        ; created_at  - when the directory dates the entry
  ? 1 => entry-time,        ; modified_at - when the save was last written
} / {
    1 => entry-time,
}

; A reading, and the offset of the zone its wall clock is in where a producer
; knows it. Each reading carries its own offset, since a save created in winter
; and last written in summer was kept at two.
entry-time = [
    entry-seconds,
  ? utc-offset,
]

; The wall clock the entry records, as whole seconds on the Unix scale, reached
; by reading that wall clock as though it were UTC. Tag 1 over an integer, never
; a float. Directories count from wherever suits them, a GameCube entry from
; 2000-01-01 and a Saturn entry in minutes from 1980-01-01, and converting that
; once is the work this key exists to do.
;
; It is not an instant. Most consoles here never record the zone their clock was
; set to, so the seconds alone fix a wall clock rather than a point in time.
entry-seconds = #6.1(int)

; Seconds east of UTC of the zone the wall clock is in, so the instant is the
; reading minus this. Present only where a producer knows that zone. The reading
; means the same with or without it.
;
; The range is the span real zones occupy, -12:00 through +14:00.
utc-offset = -43200..50400
